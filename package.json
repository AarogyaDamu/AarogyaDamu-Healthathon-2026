{
  "name": "aarogyadamu-project3",
  "version": "1.0.0",
  "private": true,
  "description": "AarogyaDamu — Diabetes Care Journey Companion (Health-a-thon 2026)",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:contracts && npm run build:api && npm run build:web",
    "build:contracts": "npm --workspace=packages/contracts run build",
    "build:api": "npm --workspace=services/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "start:api": "npm --workspace=services/api run start",
    "db:generate": "npm --workspace=services/api run prisma:generate",
    "db:validate": "npm --workspace=services/api run prisma:validate",
    "db:migrate": "npm --workspace=services/api run prisma:migrate",
    "db:deploy": "npm --workspace=services/api run prisma:deploy",
    "db:status": "npm --workspace=services/api run prisma:status",
    "db:seed": "npm --workspace=services/api run prisma:seed",
    "dev": "npm run dev:api",
    "dev:api": "npm --workspace=services/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:mobile": "npm --workspace=apps/mobile run start",
    "dev:mobile:web": "npm --workspace=apps/mobile run web",
    "dev:mobile:android": "npm --workspace=apps/mobile run android",
    "dev:mobile:ios": "npm --workspace=apps/mobile run ios",
    "test": "npm run test:api && npm run test:web && npm run test:mobile",
    "test:api": "npm --workspace=services/api run test",
    "test:web": "npm --workspace=apps/web run test",
    "test:mobile": "npm --workspace=apps/mobile run test",
    "typecheck": "npm run typecheck:mobile && npm run build:contracts && npm run build:api && npm run build:web",
    "typecheck:mobile": "node apps/mobile/node_modules/typescript/bin/tsc --noEmit --project apps/mobile/tsconfig.json"
  },
  "devDependencies": {
    "metro": "^0.82.5",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  }
}