{
  "name": "aarogyadamu-project3",
  "version": "1.0.0",
  "private": true,
  "description": "AarogyaDamu — Diabetes Care Journey Companion (Health-a-thon 2026)",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace=services/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "db:generate": "npm --workspace=services/api run prisma:generate",
    "db:migrate": "npm --workspace=services/api run prisma:migrate",
    "db:seed": "npm --workspace=services/api run prisma:seed",
    "dev": "npm run dev:api",
    "dev:api": "npm --workspace=services/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:mobile": "npm --workspace=apps/mobile run start",
    "dev:mobile:web": "npm --workspace=apps/mobile run web",
    "dev:mobile:android": "npm --workspace=apps/mobile run android",
    "dev:mobile:ios": "npm --workspace=apps/mobile run ios",
    "test": "npm run test:api && npm run test:web && npm run test:mobile",
    "test:api": "npm --workspace=services/api run test",
    "test:web": "npm --workspace=apps/web run test",
    "test:mobile": "npm --workspace=apps/mobile run test",
    "typecheck:mobile": "npm --workspace=apps/mobile exec tsc -- --noEmit"
  },
  "devDependencies": {
    "metro": "^0.82.5",
    "typescript": "~5.3.3"
  }
}
