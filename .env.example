# AarogyaDamu Monorepo Environment Template
# Copy this file to .env for local development. Never commit real secrets.
NODE_ENV="development"
APP_ENV="development"
PORT=4000
DATABASE_URL="postgresql://aarogyadamu:change-me@localhost:5432/aarogyadamu_dev?schema=public"

# Authentication Secrets (Production requires distinct 32+ char cryptographic secrets)
JWT_SECRET="replace-with-a-unique-32-plus-character-secret-from-your-secret-manager"
JWT_EXPIRES_IN="15m"
JWT_ISSUER="aarogyadamu-api"
JWT_AUDIENCE="aarogyadamu-clients"
REFRESH_TOKEN_EXPIRES_DAYS=30

# Doctor Onboarding & Invitation Provisioning
DOCTOR_INVITATION_SECRET="replace-with-a-separate-unique-32-plus-character-invitation-secret"
DOCTOR_INVITATION_ADMIN_KEY="replace-with-a-different-unique-32-plus-character-admin-key"
# Provision a 48-hour, email-bound invitation via POST /api/auth/doctor-invitations
# using X-Doctor-Invitation-Admin-Key, then deliver its token to the doctor out of band.

# Email Delivery (Resend required in production)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="replace-with-your-resend-api-key"
EMAIL_FROM="security@aarogyadamu.com"
WEB_APP_URL="https://app.example.com"
API_PUBLIC_URL="https://app.example.com/api"

# FHIR R4 Interoperability Base URL
FHIR_SERVER_URL="https://app.example.com/api/fhir/r4"

# Network, CORS & Reverse Proxy Hardening
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:4173,http://localhost:8081,http://localhost:8082,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:8081,http://127.0.0.1:8082"
# In multi-instance behind a reverse proxy (e.g., ALB/Cloudflare), set TRUST_PROXY to 1 or trusted CIDRs (never "true")
TRUST_PROXY="false"

# Multi-Instance Rate Limiting (memory for local dev, redis for distributed cluster)
RATE_LIMIT_STORE="memory"
REDIS_URL="redis://default:replace-with-redis-pass@localhost:6379"

ENABLE_DEV_DEMO_MODE="false"
ALLOW_DEMO_AUTH="false"
STORAGE_DIR="./uploads/private"
UPLOAD_DIR="./uploads"
MEDICAL_REPORT_OCR_PROVIDER="synthetic"
GEMINI_API_KEY=""
LLM_PROVIDER=""
LLM_API_KEY=""
SARVAM_API_KEY=""
SARVAM_TTS_MODEL="bulbul:v4-flash"
SARVAM_TTS_SPEAKER="shubh_enhi_ads"
SARVAM_STT_MODEL="saarika:v2"
ALLOW_ROBOTIC_VOICE_FALLBACK="false"
GROQ_API_KEY=""

# Google Cloud Vision medical-report OCR (server only; never put service-account keys in the mobile app)
GOOGLE_APPLICATION_CREDENTIALS="C:\\path\\to\\service-account.json"
# Optional when Application Default Credentials can detect the project.
GOOGLE_CLOUD_PROJECT_ID=""
# Required for PDF OCR. Set the bucket name only (not a gs:// URL).
GOOGLE_CLOUD_STORAGE_BUCKET=""
