# AarogyaDamu Expo Mobile Application Environment Template
# Copy to apps/mobile/.env for local development or configure in EAS Build secrets

# Environment mode: 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development

# Development: http://localhost:4000/api or LAN IP (e.g., http://192.168.1.100:4000/api)
# Production: https://app.example.com/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
