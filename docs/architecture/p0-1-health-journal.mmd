%% DIAGRAM 4: DATABASE SCHEMA & RELATIONAL INTERACTIONS
%% -------------------------------------------------------------------------
```mermaid
erDiagram
    User ||--o{ HealthObservation : "submits_or_subject_of"
    User ||--o{ PatientProfile : "has"
    User ||--o{ CaregiverConsent : "grants_or_receives"
    User ||--o{ AuditLog : "mutates_or_accesses"
    HealthObservation ||--o{ AuditLog : "correction_history"

    HealthObservation {
        string id PK
        string userId FK "Patient ID"
        string type "BLOOD_GLUCOSE | BLOOD_PRESSURE | WEIGHT | HBA1C"
        float numericValue "Primary metric value"
        float secondaryValue "Nullable: Diastolic BP"
        string unit "mg/dL | mmol/L | mmHg | kg | %"
        string context "FASTING | PRE_MEAL | POST_MEAL_2HR | BEDTIME | RANDOM"
        string clinicalFlag "NORMAL | IN_TARGET | LOW | HIGH | CRITICAL_LOW | HYPERTENSIVE_CRISIS"
        string notes "Patient or clinician notes"
        string provenance "PATIENT_ENTERED | CAREGIVER_ENTERED | DOCTOR_ENTERED"
        string sourceProvenance "MANUAL_PATIENT | BLUETOOTH_DEVICE | LAB_REPORT | DOCTOR_CLINICAL"
        string deviceModel "e.g. Accu-Chek Guide, Omron Hem-7120"
        string idempotencyKey "Unique client submission UUID"
        datetime observedAt "Measurement timestamp"
        datetime createdAt "Server ingestion timestamp"
    }

    AuditLog {
        string id PK
        string userId "Target Patient ID"
        string actorId "Operator User ID"
        string action "OBSERVATION_CREATED | OBSERVATION_AMENDED | OBSERVATION_DELETED"
        string entityType "HealthObservation"
        string entityId "FK to HealthObservation"
        string metadata "JSON: Prior state, new state, amendment reason, PHI redacted"
        datetime createdAt
    }

    PatientProfile {
        string id PK
        string userId FK
        float targetFastingMin "Default 80"
        float targetFastingMax "Default 130"
        float targetPostMealMax "Default 180"
    }
```

%% -------------------------------------------------------------------------
%% DIAGRAM 5: PROVENANCE AND PERMISSION FLOW
%% -------------------------------------------------------------------------
```mermaid
stateDiagram-v2
    [*] --> IngestionRequest: Vital reading received with source provenance

    state IngestionRequest {
        [*] --> IdentifySource
        IdentifySource --> SourcePatient: sourceProvenance: 'MANUAL_PATIENT'
        IdentifySource --> SourceCaregiver: sourceProvenance: 'CAREGIVER_INPUT'
        IdentifySource --> SourceBluetooth: sourceProvenance: 'BLUETOOTH_DEVICE'
        IdentifySource --> SourceDoctor: sourceProvenance: 'DOCTOR_CLINICAL'
        IdentifySource --> SourceLab: sourceProvenance: 'LAB_REPORT'
    }

    state PermissionValidation {
        [*] --> VerifyRelationship
        VerifyRelationship --> PatientSelfCheck: Actor is Patient
        VerifyRelationship --> CaregiverConsentCheck: Actor is Caregiver
        VerifyRelationship --> DoctorAssignmentCheck: Actor is Doctor
    }

    SourcePatient --> PermissionValidation
    SourceCaregiver --> PermissionValidation
    SourceBluetooth --> PermissionValidation
    SourceDoctor --> PermissionValidation
    SourceLab --> PermissionValidation

    state CaregiverConsentCheck {
        [*] --> ActiveConsentQuery
        ActiveConsentQuery --> ScopeVerified: 'MANAGE_OBSERVATIONS' in permissions
        ActiveConsentQuery --> ScopeRevokedOrMissing: Not found or expired
    }

    ScopeRevokedOrMissing --> AccessDenied: 403 Forbidden
    ScopeVerified --> EvaluatedAndSaved: Persisted with 'CAREGIVER_INPUT' tag
    PatientSelfCheck --> EvaluatedAndSaved: Persisted with 'MANUAL_PATIENT' or 'BLUETOOTH_DEVICE'
    DoctorAssignmentCheck --> EvaluatedAndSaved: Persisted with 'DOCTOR_CLINICAL' tag

    AccessDenied --> [*]
    EvaluatedAndSaved --> [*]
```

%% -------------------------------------------------------------------------
%% DIAGRAM 6: ERROR AND RECOVERY PIPELINE
%% -------------------------------------------------------------------------
```mermaid
flowchart TD
    ReqIn([Client Vital Submission]) --> ValCheck{Input Validation Passed?}

    ValCheck -- No (Missing type, negative value, invalid unit) --> Ret400[400 Bad Request <br/> 'Reading must be a positive number']
    
    ValCheck -- Yes --> IdemCheck{idempotencyKey provided?}
    IdemCheck -- Yes --> SearchKey{Existing key in DB?}
    SearchKey -- Key Exists --> ReturnCached[200 OK: Replay cached observation without duplicate write]
    SearchKey -- New Key --> PersistWrite[Proceed to Clinical Evaluation & Storage]
    IdemCheck -- No Key --> PersistWrite

    PersistWrite --> StorageAttempt{Database Write Success?}
    StorageAttempt -- Success --> EmitSuccess[201 Created with Safety Evaluation]
    StorageAttempt -- DB Failure / Lock --> Ret500[500 Internal Error + incidentId]
    
    Ret500 --> ClientRetryQueue[Client Offline Queue preserves item for exponential backoff retry]
```

