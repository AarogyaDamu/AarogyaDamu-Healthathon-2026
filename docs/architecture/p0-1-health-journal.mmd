    end

    subgraph ResponseOutputs ["Client Responses"]
        OutList["200 OK: Paginated observations with timestamps & flags"]
        OutCreated["201 Created: New observation + safety evaluation"]
        OutAmended["200 OK: Updated observation (Prior value preserved in audit trail)"]
        OutSummary["200 OK: Aggregated TIR%, Mean, Min, Max, CV%"]
    end

    Q_List --> AuthGate --> ContextGate --> OutList
    Q_Summary --> AuthGate --> ContextGate --> OutSummary
    Q_Post --> AuthGate --> ContextGate --> IdemGate --> SafetyEngine --> OutCreated
    Q_Patch --> AuthGate --> ContextGate --> AuditRecorder --> SafetyEngine --> OutAmended
```

