%% -------------------------------------------------------------------------
%% DIAGRAM A: HIGH-LEVEL PIPELINE ARCHITECTURE
%% -------------------------------------------------------------------------
```mermaid
graph TB
    subgraph ClientLayer ["Client Layer (Separated Products)"]
        MobileApp["Mobile App (Patient & Caregiver) <br/> React Native / Expo"]
        DoctorWeb["Doctor Web Portal (Clinician Only) <br/> React / Vite"]
    end

    subgraph GatewayLayer ["Security & Routing Gateway"]
        CORS["CORS & Secure Headers <br/> (HSTS, nosniff, DENY frame)"]
        RateLimiter["Rate Limiting & Token Bucket <br/> (Multi-instance aware)"]
        AuthMiddleware["Auth Middleware <br/> (JWT + Server-side Session Revocation)"]
        FeatureFlags["Feature Flag Guard <br/> (Rollout Tier & Phase Isolation)"]
    end

    subgraph SafetyFoundationLayer ["Phase P0.0 Safety & Data Foundation"]
        PermGuard["Permission Guard & Context Resolver <br/> (Patient / Caregiver Consent / Clinician)"]
        SafetyEvaluator["Clinical Safety Evaluator <br/> (ADA Guidelines: Glucose, BP, HbA1c)"]
        AISafetyHarness["AI Safety Harness & Risk Classifier <br/> (LOW, MEDIUM, HIGH, PROHIBITED)"]
        ApprovalMgr["Human-in-the-Loop Approval Manager <br/> (Clinician Verification Gate)"]
        AuditLogger["Medical Audit Logger & PHI Redactor <br/> (safeClinicalLog, Access/Mutation Trails)"]
        ErrorHandler["Healthcare Error Handler <br/> (Incident Tracking & Redacted Diffs)"]
    end

    subgraph PersistenceLayer ["Persistence Layer (SQLite / Prisma)"]
        DB_Obs[("HealthObservation <br/> +clinicalFlag, secondaryValue, idempotencyKey")]
        DB_Flags[("FeatureFlag <br/> +id, isEnabled, rolloutTier")]
        DB_AgentAudit[("AgentAuditRecord <br/> +riskTier, approvalStatus, approvedBy")]
        DB_AuditLog[("AuditLog <br/> +entityType, PHI-redacted metadata")]
        DB_Core[("User, Profile, Consent, CarePlan")]
    end

    MobileApp --> CORS
    DoctorWeb --> CORS
    CORS --> RateLimiter
    RateLimiter --> AuthMiddleware
    AuthMiddleware --> FeatureFlags
    FeatureFlags --> PermGuard

    PermGuard --> SafetyEvaluator
    PermGuard --> AISafetyHarness
    AISafetyHarness --> ApprovalMgr

    SafetyEvaluator --> DB_Obs
    FeatureFlags --> DB_Flags
    AISafetyHarness --> DB_AgentAudit
    ApprovalMgr --> DB_AgentAudit
    AuditLogger --> DB_AuditLog
    PermGuard --> DB_Core

    SafetyEvaluator -.-> AuditLogger
    ApprovalMgr -.-> AuditLogger
    ErrorHandler -.-> AuditLogger
```

%% -------------------------------------------------------------------------
%% DIAGRAM B: COMPLETE DATA-FLOW DIAGRAM (VITAL OBSERVATION PIPELINE)
%% -------------------------------------------------------------------------
```mermaid
sequenceDiagram
    autonumber
    actor Client as Patient / Caregiver App
    participant Route as Express API (/api/observations)
    participant Auth as Auth & Context Evaluator
    participant Idem as Idempotency Store
    participant Safety as Clinical Safety Evaluator
    participant DB as SQLite Database
    participant Audit as Clinical Audit Logger

    Client->>Route: POST /api/observations {type, numericValue, secondaryValue, context, idempotencyKey}
    Route->>Auth: Verify JWT & Resolve Patient Context (MANAGE_OBSERVATIONS)
    Auth-->>Route: Context Verified (effectivePatientId)

    alt Idempotency Key Present
        Route->>Idem: Check existing observation by idempotencyKey
        opt Key Exists
            Idem-->>Route: Return existing observation record
            Route-->>Client: 200 OK (isIdempotentReplay: true, observation)
        end
    end

    Route->>Safety: evaluateClinicalSafety(type, numericValue, secondaryValue, context)
    Note over Safety: Evaluates ADA Standard Thresholds<br/>CRITICAL_LOW, LOW, IN_TARGET, HIGH, CRITICAL_HIGH,<br/>STAGE_1/2_HYPERTENSION, HYPERTENSIVE_CRISIS
    Safety-->>Route: SafetyEvaluationResult {clinicalFlag, isCritical, requiresEmergencyEscalation, clinicalMessage, actionableGuidance}

    Route->>DB: prisma.healthObservation.create({clinicalFlag, sourceProvenance, secondaryValue, ...})
    DB-->>Route: Saved Observation Record

    Route->>Audit: logClinicalMutationEvent({userId, actorId, action: 'OBSERVATION_CREATED', metadata})
    Note over Audit: Sanitizes PHI, redacts auth tokens,<br/>persists to AuditLog table asynchronously
    Audit-->>DB: prisma.auditLog.create(...)

    Route-->>Client: 201 Created {observation, safetyEvaluation}
```

%% -------------------------------------------------------------------------
%% DIAGRAM C: API / BACKEND INTERACTION DIAGRAM
%% -------------------------------------------------------------------------
```mermaid
flowchart TD
    subgraph ClientRequests ["Client API Invocations"]
        ReqObs["POST /api/observations"]
        ReqFlags["GET /api/features <br/> POST /api/features/:key/toggle"]
        ReqAIProp["POST /api/ai/proposals"]
        ReqAIRev["POST /api/ai/proposals/:id/review"]
    end

    subgraph BackendProcessing ["Backend Processing Modules"]
        M_Auth["requireAuth & requireClinician"]
        M_Feat["requireFeature(FLAG_KEY)"]
        M_Perm["resolvePatientContext()"]
        M_Safe["evaluateClinicalSafety()"]
        M_Risk["classifyAgentIntent()"]
        M_Appr["reviewAgentProposal()"]
        M_Audit["logClinicalMutationEvent()"]
    end

    subgraph Responses ["Standardized HTTP Responses"]
        Res200["200 OK / 201 Created <br/> Standard Body + Metadata"]
        Res400["400 Bad Request <br/> HealthcareApiError"]
        Res403["403 Forbidden <br/> FEATURE_DISABLED / Unauthorized"]
        Res500["500 Internal Error <br/> HealthcareErrorResponse + incidentId"]
    end

    ReqObs --> M_Auth --> M_Perm --> M_Safe --> M_Audit --> Res200
    ReqFlags --> M_Feat --> Res200
    ReqAIProp --> M_Auth --> M_Risk
    M_Risk -- "LOW_RISK" --> Res200
    M_Risk -- "MEDIUM / HIGH_RISK" --> Res200
    M_Risk -- "PROHIBITED" --> Res400
    ReqAIRev --> M_Auth --> M_Appr --> M_Audit --> Res200

    M_Feat -- "Flag is false" --> Res403
    M_Perm -- "Scope missing" --> Res403
```

