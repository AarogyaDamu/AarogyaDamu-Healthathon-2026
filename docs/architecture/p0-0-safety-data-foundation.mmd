%% -------------------------------------------------------------------------
%% DIAGRAM F: ERROR-HANDLING AND RECOVERY FLOW
%% -------------------------------------------------------------------------
```mermaid
flowchart TD
    Start([Incoming API Request]) --> TryBlock[Execute Route Handler]
    TryBlock --> Condition{Exception Thrown?}

    Condition -- No --> SendSuccess[Send 200/201 Success Response]

    Condition -- Yes --> CatchBlock[Capture in healthcareErrorHandler]
    CatchBlock --> GenIncident[Generate Unique incidentId via randomUUID]
    CatchBlock --> ClassifyStatus{Error Type}

    ClassifyStatus -- "Validation Error (Zod)" --> Err400[Status 400: VALIDATION_ERROR]
    ClassifyStatus -- "Auth / Permission Denial" --> Err403[Status 403: FORBIDDEN / FEATURE_DISABLED]
    ClassifyStatus -- "Entity Missing" --> Err404[Status 404: RESOURCE_NOT_FOUND]
    ClassifyStatus -- "Unique Key Conflict" --> Err409[Status 409: IDEMPOTENCY_CONFLICT]
    ClassifyStatus -- "Unhandled Exception" --> Err500[Status 500: INTERNAL_SERVER_ERROR]

    Err400 --> Sanitize[Sanitize PHI & Stack Trace]
    Err403 --> Sanitize
    Err404 --> Sanitize
    Err409 --> Sanitize
    Err500 --> Sanitize

    Sanitize --> LogSafe[safeClinicalLog to console.error without PHI]
    LogSafe --> SendClient[Send HealthcareErrorResponse: <br/> { success: false, error: message, code, incidentId, timestamp }]
```

%% -------------------------------------------------------------------------
%% DIAGRAM G: CONSENT, PERMISSION AND APPROVAL FLOW
%% -------------------------------------------------------------------------
```mermaid
stateDiagram-v2
    [*] --> RequestInitiated: Client submits action proposal or data mutation

    state RequestInitiated {
        [*] --> CheckActorRole
        CheckActorRole --> PatientDirect: Actor is Patient
        CheckActorRole --> ClinicianDirect: Actor is Clinician
        CheckActorRole --> CaregiverCheck: Actor is Caregiver
        CheckActorRole --> UnauthorizedActor: Actor not found / invalid
    }

    UnauthorizedActor --> RejectedState: 403 Forbidden

    state CaregiverCheck {
        [*] --> VerifyActiveConsent
        VerifyActiveConsent --> ConsentExpired: Consent past expiresAt
        VerifyActiveConsent --> VerifyScope: Active consent exists
        VerifyScope --> ScopeGranted: Permission in permissions array
        VerifyScope --> ScopeDenied: Permission missing
    }

    ConsentExpired --> RejectedState: 403 Consent Expired
    ScopeDenied --> RejectedState: 403 Granular Scope Denied

    state AIProposalEvaluation {
        [*] --> ClassifyRisk
        ClassifyRisk --> LowRisk: Informational query / lifestyle tips
        ClassifyRisk --> MediumRisk: Follow-up scheduling / task draft
        ClassifyRisk --> HighRisk: Medication changes / clinical notes
        ClassifyRisk --> ProhibitedRisk: Autonomous diagnosis / prescribing
    }

    PatientDirect --> AIProposalEvaluation
    ClinicianDirect --> ApprovedState: Doctor direct override
    ScopeGranted --> AIProposalEvaluation

    ProhibitedRisk --> RejectedState: Instant Rejection & Audit Logged
    LowRisk --> ApprovedState: Auto-executed autonomously

    MediumRisk --> PendingReview: Requires Patient/Caregiver Confirmation
    HighRisk --> PendingDoctorReview: Requires Licensed Doctor Authorization

    state PendingDoctorReview {
        [*] --> AwaitingClinician
        AwaitingClinician --> DoctorApproved: Doctor signs off
        AwaitingClinician --> DoctorRejected: Doctor rejects
    }

    PendingReview --> ApprovedState: Patient confirms
    PendingReview --> RejectedState: Patient denies
    DoctorApproved --> ApprovedState: Proposal Applied
    DoctorRejected --> RejectedState: Proposal Discarded

    ApprovedState --> [*]
    RejectedState --> [*]
```
